---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import site from '@/data/site.json';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@fontsource/baskervville/400.css';
import '@fontsource/baskervville/400-italic.css';
import '@fontsource/baskervville/700.css';
import '@fontsource/baskervville/700-italic.css';
import fontRegular from '@fontsource/baskervville/files/baskervville-latin-400-normal.woff2?url';
import fontItalic from '@fontsource/baskervville/files/baskervville-latin-400-italic.woff2?url';
import '@/styles/global.css';

interface Props {
  /** Page title without the site name (omit on the home page). */
  title?: string;
  description?: string;
  /** Image used for social sharing cards. */
  ogImage?: ImageMetadata;
  ogAlt?: string;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Header floats over the page content (home page hero). */
  overlayHeader?: boolean;
  bodyClass?: string;
}

const { title, description = site.description, ogImage, ogAlt, jsonLd = [], overlayHeader = false, bodyClass } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage ? await getImage({ src: ogImage, width: 1200, format: 'jpeg', quality: 80, layout: 'none' }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : null;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Artist',
  description: site.description,
  email: site.social.find((s) => s.type === 'email')?.href.replace('mailto:', ''),
  sameAs: site.social.filter((s) => s.type !== 'email').map((s) => s.href),
  knowsAbout: ['Installation art', 'Painting', 'Ceramics', 'Korean pigment painting (Minhwa)'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#fff3e6" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content={String(og!.attributes.width)} />}
    {ogUrl && <meta property="og:image:height" content={String(og!.attributes.height)} />}
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={fontRegular} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontItalic} crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}
    <Analytics />
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, { 'has-overlay-header': overlayHeader }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute; left: var(--gutter); top: -100px; z-index: 100;
    padding: 0.5em 1em; background: var(--fg); color: var(--bg);
  }
  .skip-link:focus { top: 8px; }
</style>
