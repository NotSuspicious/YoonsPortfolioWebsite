---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="not-found container">
    <h1>Page not found</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <p><a href="/">Home</a> · <a href="/works/">Works</a> · <a href="/exhibitions/">Exhibitions</a> · <a href="/about/">About</a></p>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 50vh; display: grid; place-content: center; text-align: center; padding: var(--section-pad) 0; }
  .not-found h1 { font-size: var(--fs-h2); }
  .not-found a { text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
</style>
