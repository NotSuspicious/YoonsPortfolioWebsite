---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import site from '@/data/site.json';
import { siteUrl } from '@/lib/site';

const jsonLd = [
  {
    '@type': 'WebSite',
    name: site.name,
    url: siteUrl,
    description: site.description,
  },
];
---

<BaseLayout description={site.description} jsonLd={jsonLd} overlayHeader bodyClass="page-home">
  <h1 class="visually-hidden">{site.name} — interdisciplinary artist: installation, painting, ceramics</h1>
  <Hero />
</BaseLayout>
