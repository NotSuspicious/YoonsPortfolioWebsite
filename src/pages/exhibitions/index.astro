---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HoverIndex from '@/components/HoverIndex.astro';
import site from '@/data/site.json';
import { siteUrl } from '@/lib/site';
import { media } from '@/lib/media';

const exhibitions = (await getCollection('exhibitions')).sort((a, b) => a.data.order - b.data.order);
const items = exhibitions.map((e) => ({ title: `${e.data.title} (${e.data.year})`, href: `/exhibitions/${e.id}/`, src: e.data.cover.src, alt: e.data.cover.alt }));
const description = `Exhibitions by Yoon Lee: ${exhibitions.map((e) => `${e.data.title} (${e.data.year})`).join(', ')}. Installation views, works and statements.`;
const jsonLd = [{
  '@type': 'CollectionPage',
  name: `Exhibitions — ${site.name}`,
  url: `${siteUrl}/exhibitions/`,
  hasPart: exhibitions.map((e) => ({ '@type': 'ExhibitionEvent', name: e.data.title, startDate: e.data.year, url: `${siteUrl}/exhibitions/${e.id}/` })),
}];
---

<BaseLayout title="Exhibitions" description={description} ogImage={media(items[0].src)} ogAlt={items[0].alt} jsonLd={jsonLd} overlayHeader>
  <h1 class="visually-hidden">Exhibitions</h1>
  <HoverIndex items={items} />
</BaseLayout>
