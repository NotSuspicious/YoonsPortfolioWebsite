---
/**
 * Thumbnail grid (square crop, 4 columns / 2 on phones). Items either link to a page or open the lightbox.
 */
import { getImage } from 'astro:assets';
import Pic from './Pic.astro';
import { media, dims } from '@/lib/media';

type Item = { src: string; alt: string; href?: string; title?: string | null; lightbox?: boolean; caption?: string | null };
interface Props { items: Item[]; columns?: number; priorityCount?: number; id?: string }
const { items, columns = 4, priorityCount = 0, id } = Astro.props;
const sizes = `(max-width: 767px) 50vw, ${Math.round(100 / columns)}vw`;

// Pre-render an optimised large version for lightbox-only items
const entries = await Promise.all(
  items.map(async (item) => {
    const img = media(item.src);
    const big = item.href ? null : await getImage({ src: img, width: Math.min(1800, dims(img).width), format: 'webp', quality: 80, layout: 'none' });
    return { item, img, big };
  })
);
---

<div class="grid" style={`--cols:${columns}`} data-reveal-group="50" id={id}>
  {entries.map(({ item, img, big }, i) => (
    <figure class="grid__item" data-reveal>
      {item.href ? (
        <a class="grid__link" href={item.href} aria-label={item.title ? `View ${item.title}` : undefined}>
          <Pic src={img} alt={item.alt} sizes={sizes} widths={[360, 540, 720, 1080]} priority={i < priorityCount} class="grid__img" />
        </a>
      ) : (
        <button
          class="grid__link"
          type="button"
          data-lightbox-src={big!.src}
          data-lightbox-w={big!.attributes.width}
          data-lightbox-h={big!.attributes.height}
          data-lightbox-alt={item.alt}
          data-lightbox-caption={item.caption ?? ''}
          aria-label={`Open image: ${item.alt}`}
        >
          <Pic src={img} alt={item.alt} sizes={sizes} widths={[360, 540, 720, 1080]} priority={i < priorityCount} class="grid__img" />
        </button>
      )}
    </figure>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 0.6vw;
    padding: 0 0.6vw;
  }
  .grid__item { position: relative; aspect-ratio: 1; overflow: hidden; }
  .grid__link { display: block; width: 100%; height: 100%; cursor: pointer; }
  .grid :global(.grid__img) {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), opacity 0.4s var(--ease);
  }
  @media (hover: hover) {
    .grid__link:hover :global(.grid__img) { transform: scale(1.03); opacity: 0.92; }
  }
  @media (max-width: 767px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2vw; padding: 0 1.2vw; }
  }
</style>
