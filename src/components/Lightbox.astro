---
/**
 * Single shared lightbox for [data-lightbox-src] buttons on the page. Navigates between all
 * lightbox items in document order; keyboard (←/→/Esc) and swipe supported.
 */
---

<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
  <button class="lightbox__close" type="button" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 9 16" aria-hidden="true"><polyline fill="none" stroke="currentColor" stroke-miterlimit="10" points="7.3,14.7 2.5,8 7.3,1.2" /></svg>
  </button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" decoding="async" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 9 16" aria-hidden="true"><polyline fill="none" stroke="currentColor" stroke-miterlimit="10" points="1.6,1.2 6.5,7.9 1.6,14.7" /></svg>
  </button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-src]'));
  if (dialog && triggers.length) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const cap = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index];
      img.classList.remove('is-loaded');
      img.src = t.dataset.lightboxSrc!;
      img.width = Number(t.dataset.lightboxW) || 0;
      img.height = Number(t.dataset.lightboxH) || 0;
      img.alt = t.dataset.lightboxAlt || '';
      cap.textContent = t.dataset.lightboxCaption || '';
      cap.hidden = !cap.textContent;
      prev.hidden = next.hidden = triggers.length < 2;
      const done = () => img.classList.add('is-loaded');
      if (img.complete) done(); else img.addEventListener('load', done, { once: true });
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      dialog.showModal();
      document.body.classList.add('menu-open');
    };
    const close = () => {
      dialog.close();
      document.body.classList.remove('menu-open');
      opener?.focus();
    };

    triggers.forEach((t, i) => t.addEventListener('click', () => open(i, t)));
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let x0 = 0;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: transparent; color: var(--fg);
  }
  .lightbox::backdrop { background: rgb(255 243 230 / 0.96); }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in 0.35s var(--ease); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }

  .lightbox__figure { display: grid; justify-items: center; gap: 1em; max-width: 100vw; padding: 0 clamp(48px, 8vw, 96px); }
  .lightbox__img {
    max-width: min(90vw, 1800px); max-height: 82vh; width: auto; height: auto;
    object-fit: contain;
    opacity: 0; transition: opacity 0.45s var(--ease);
  }
  .lightbox__img.is-loaded { opacity: 1; }
  .lightbox__caption { text-align: center; max-width: 60ch; }
  .lightbox__caption[hidden] { display: none; }

  .lightbox__close { position: fixed; top: max(12px, 2vw); right: max(12px, 2vw); width: 40px; height: 40px; padding: 8px; z-index: 1; }
  .lightbox__nav { position: fixed; top: 50%; transform: translateY(-50%); width: 56px; height: 72px; padding: 24px 20px; z-index: 1; }
  .lightbox__nav--prev { left: max(4px, 1.5vw); }
  .lightbox__nav--next { right: max(4px, 1.5vw); }
  .lightbox__nav[hidden] { display: none; }
  .lightbox button svg { width: 100%; height: 100%; }
  .lightbox button { transition: opacity 0.25s var(--ease); }
  .lightbox button:hover { opacity: 0.5; }

  @media (max-width: 767px) {
    .lightbox__figure { padding: 0 8px; }
    .lightbox__nav { width: 44px; height: 60px; padding: 18px 14px; }
  }
</style>
